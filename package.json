{
  "name": "100-deep",
  "private": true,
  "version": "0.1.0",
  "description": "First-person, controller-friendly frontend for the real Angband engine",
  "license": "GPL-2.0-only",
  "type": "module",
  "workspaces": [
    "shared/protocol",
    "bridge",
    "client"
  ],
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "build:engine": "sh scripts/build-engine.sh",
    "build:client": "npm run build -w client",
    "build": "npm run build:engine && npm run build:client",
    "build:web": "node scripts/build-web.ts",
    "serve:web": "npm exec -w client -- vite preview --outDir dist-web --port 4173 --strictPort",
    "dev": "node scripts/dev.ts",
    "start": "npm run build && node bridge/src/index.ts --open",
    "test": "npm run test:engine && npm run test:bridge && npm run test:client",
    "test:engine": "node --test tests/engine/*.test.ts",
    "test:client": "npm run test -w client",
    "typecheck": "tsc -p bridge && tsc -p client --noEmit",
    "launch": "sh scripts/launch.sh",
    "make-app": "node scripts/make-app.ts",
    "test:bridge": "node --test tests/bridge/*.test.ts",
    "test:wasm": "node --test tests/engine/wasm.test.ts",
    "publish:itch": "butler push client/dist-web ${ITCH_TARGET:?set ITCH_TARGET=yourname/100-deep}:html5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
